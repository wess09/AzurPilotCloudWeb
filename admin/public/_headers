/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cache-Control: no-cache
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src wss://api.azurpilot.com wss://templates-api.azurpilot.com; frame-ancestors 'none'; base-uri 'none'
/assets/*
  Cache-Control: public, max-age=31536000, immutable
