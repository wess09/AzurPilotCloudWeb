/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cache-Control: no-cache
  Content-Security-Policy: default-src 'self'; script-src 'self' __NEXT_SCRIPT_HASHES__; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' wss://api.azurpilot.com wss://templates-api.azurpilot.com; frame-ancestors 'none'; base-uri 'none'
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
